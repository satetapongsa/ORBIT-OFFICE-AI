# =============================================================================
# ORBIT OFFICE AI — production configuration template
# Copy to `.env.production` on the server (never commit it), replace every CHANGE_ME and
# keep the file readable by the deploy user only:  chmod 600 .env.production
# The backend refuses to start while a CHANGE_ME, a development default or a weak secret is
# left (see docs/DEPLOYMENT.md). Generate secrets with:  openssl rand -hex 32
# =============================================================================

# --- Site ---------------------------------------------------------------------
ENVIRONMENT=production
ORBIT_DOMAIN=office.example.com
FRONTEND_BASE_URL=https://office.example.com
APP_TIMEZONE=Asia/Bangkok
LOG_LEVEL=INFO
# TLS certificate directory with fullchain.pem + privkey.pem (see docs/DEPLOYMENT.md §3)
TLS_CERT_DIR=./infra/nginx/certs
HTTP_PORT=80
HTTPS_PORT=443
ORBIT_VERSION=latest

# --- Authentication -----------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_64_hex_characters_from_openssl_rand
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_ABSOLUTE_DAYS=30
PASSWORD_MIN_LENGTH=12
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# Cookies are Secure automatically in production; do not set COOKIE_SECURE=false.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=orbit
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=orbit_office

# --- Redis (password protected; broker, rate limits) --------------------------
REDIS_PASSWORD=CHANGE_ME

# --- Object storage -----------------------------------------------------------
# Bundled MinIO: these become its root credentials. Managed S3: set STORAGE_ENDPOINT_URL
# (leave empty for AWS), STORAGE_REGION and an access key limited to this bucket.
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=orbit-documents
STORAGE_REGION=us-east-1
UPLOAD_MAX_BYTES=26214400

# --- E-mail (notifications and password-reset links) --------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ORBIT OFFICE AI <no-reply@office.example.com>
SMTP_STARTTLS=true
SMTP_SSL=false

# --- AI (optional; see docs/RUNBOOK.md §5a) -----------------------------------
AI_CHAT_PROVIDER=disabled
AI_CHAT_MODEL=
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_EMBEDDING_PROVIDER=disabled
AI_EMBEDDING_MODEL=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_DIMENSIONS=1024

# --- Monitoring ---------------------------------------------------------------
# Readiness details (GET /api/v1/health) are hidden from the public in production; send
# this value as the `X-Health-Token` header from your monitoring to see them.
HEALTH_CHECK_TOKEN=CHANGE_ME
# Front end hosted separately (Vercel, docs/DEPLOYMENT.md section 9): a random value shared
# with the front end; the API then refuses requests that did not come through it.
# PROXY_SHARED_SECRET=
WORKER_CONCURRENCY=2

# --- Retention (days unless noted) --------------------------------------------
DOCUMENT_PURGE_AFTER_DAYS=30
STORAGE_ORPHAN_GRACE_HOURS=24
SESSION_PURGE_AFTER_DAYS=30
NOTIFICATION_RETENTION_DAYS=365
AI_CHAT_RETENTION_DAYS=180
