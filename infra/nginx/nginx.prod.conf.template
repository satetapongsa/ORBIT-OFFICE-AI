# ORBIT OFFICE AI — production reverse proxy (HTTPS).
# Rendered by the official nginx image at start-up: ${ORBIT_DOMAIN} comes from the environment
# (envsubst only replaces variables that are set, so $host etc. stay nginx variables).
# Certificates: /etc/nginx/certs/fullchain.pem and privkey.pem (see docs/DEPLOYMENT.md).

upstream orbit_backend {
    server backend:8000;
    keepalive 16;
}

upstream orbit_frontend {
    server frontend:3000;
    keepalive 16;
}

# Defence in depth for credential endpoints (the API has its own per-account limits).
# Behind Vercel (docs/DEPLOYMENT.md section 10) every visitor arrives from Vercel's addresses,
# so the key is the visitor IP Vercel reports. A direct caller could forge that header, but the
# API refuses any request without the proxy secret (ADR-055), so forging gains nothing.
map $http_x_vercel_forwarded_for $orbit_client_key {
    ""      $binary_remote_addr;
    default $http_x_vercel_forwarded_for;
}
limit_req_zone $orbit_client_key zone=orbit_auth:10m rate=20r/m;
limit_req_status 429;

server_tokens off;

# --- HTTP: ACME challenges, everything else goes to HTTPS ------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${ORBIT_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS -----------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${ORBIT_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:orbit_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 30m;   # keep >= UPLOAD_MAX_BYTES
    client_body_timeout 60s;
    send_timeout 60s;

    # Nginx owns the transport headers; the apps set CSP and the rest (not duplicated here).
    proxy_hide_header X-Powered-By;
    proxy_hide_header Strict-Transport-Security;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Nginx is the edge: overwrite (never append) the client address so it cannot be spoofed.
    # If a load balancer sits in front, configure set_real_ip_from/real_ip_header instead.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Connection "";

    location = /api/v1/auth/login {
        limit_req zone=orbit_auth burst=10 nodelay;
        proxy_pass http://orbit_backend;
    }

    location ^~ /api/v1/auth/password-reset {
        limit_req zone=orbit_auth burst=5 nodelay;
        proxy_pass http://orbit_backend;
    }

    location /api/ {
        proxy_pass http://orbit_backend;
        proxy_read_timeout 180s;      # AI responses can take a while
        proxy_buffering off;          # streamed (SSE) assistant answers
    }

    location / {
        proxy_pass http://orbit_frontend;
    }
}
