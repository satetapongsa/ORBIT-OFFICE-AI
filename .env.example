# =============================================================================
# AURA OFFICE AI — environment configuration (development defaults)
# Copy to `.env` (git-ignored). Values here are LOCAL DEVELOPMENT ONLY.
# Never put real credentials in this file.
#
# Hostnames below are for processes running on your machine. 127.0.0.1 is used
# instead of localhost: on Windows, localhost tries IPv6 (::1) first and stalls,
# while Docker publishes the ports on 127.0.0.1 only.
# docker-compose overrides DATABASE_URL / REDIS_URL / STORAGE_ENDPOINT_URL
# with container hostnames automatically.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | test | staging | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# LOG_JSON=                        # default: JSON logs everywhere except development
# API_DOCS_ENABLED=                # default: enabled except staging/production
# comma-separated allow-list; empty = same-origin only
CORS_ORIGINS=

# --- Security (used from Phase 2) --------------------------------------------
# Production: generate with  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production-use-64-random-bytes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- PostgreSQL + pgvector ----------------------------------------------------
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura_dev_password
POSTGRES_DB=aura_office
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://aura:aura_dev_password@127.0.0.1:5432/aura_office

# --- Redis (Celery broker, cache, rate limits) --------------------------------
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=               # default: REDIS_URL
# CELERY_RESULT_BACKEND=           # default: REDIS_URL

# --- Object storage (MinIO locally; any S3-compatible service) ----------------
MINIO_ROOT_USER=aura-minio
MINIO_ROOT_PASSWORD=aura-minio-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# MINIO_IMAGE=pgsty/minio@sha256:b6bfe7239bfc83fb90d31612d9704d86039dd714f7904b3f1ad68f211e602372
STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=aura-minio
STORAGE_SECRET_KEY=aura-minio-dev-secret
STORAGE_BUCKET=aura-documents
# dev convenience; ignored in staging/production
STORAGE_AUTO_CREATE_BUCKET=true

# --- Uploads (Phase 4) ---------------------------------------------------------
# 25 MB
UPLOAD_MAX_BYTES=26214400

# --- AI providers (Phase 6/7) ----------------------------------------------------
# Chat and embeddings are configured separately. Leave as `disabled` until a
# provider is available — the app reports "not configured" instead of faking it.
#
# Providers: disabled | openai_compatible | anthropic
#   openai_compatible — Ollama, vLLM, LM Studio, OpenAI or any compatible gateway
#   anthropic         — Claude models (chat only; Anthropic has no embeddings API)
AI_CHAT_PROVIDER=disabled
AI_CHAT_MODEL=
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_TEMPERATURE=0.2
AI_CHAT_MAX_TOKENS=4096
AI_REQUEST_TIMEOUT_SECONDS=120

AI_EMBEDDING_PROVIDER=disabled
AI_EMBEDDING_MODEL=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
# must match the model; fixed by the Phase 7 migration
AI_EMBEDDING_DIMENSIONS=1024

# Example — local Ollama (free, no API key). From Docker containers use
# http://host.docker.internal:11434/v1 instead of localhost.
#   AI_CHAT_PROVIDER=openai_compatible
#   AI_CHAT_MODEL=qwen3:8b
#   AI_CHAT_BASE_URL=http://127.0.0.1:11434/v1
#   AI_EMBEDDING_PROVIDER=openai_compatible
#   AI_EMBEDDING_MODEL=bge-m3                 # multilingual (Thai), 1024 dimensions
#   AI_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
#
# Example — Anthropic for chat (embeddings still from an openai_compatible provider):
#   AI_CHAT_PROVIDER=anthropic
#   AI_CHAT_MODEL=claude-opus-5-5
#   AI_CHAT_API_KEY=<set in your local .env or secret store>

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=8
AI_CHAT_RETENTION_DAYS=180

# --- Ports / frontend ------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=8080
# Server-side only: where the Next.js dev server proxies /api/* (local processes).
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
